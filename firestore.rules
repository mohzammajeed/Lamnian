rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mohzammajeed@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /{col}/{id} {
      allow read: if col in ['news','gallery','events','notices','directory']
                  && (resource.data.approved == true || isAdmin());
      allow create: if col in ['news','gallery','events','notices','directory']
                    && request.resource.data.approved == false
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.keys().size() <= 10
                    && (!('image' in request.resource.data)
                        || (request.resource.data.image is string
                            && request.resource.data.image.size() < 400000));
      allow update, delete: if isAdmin();
    }
  }
}
